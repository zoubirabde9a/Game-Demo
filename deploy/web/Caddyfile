# The download site's file server: the game-demo-web container serves
# /opt/game-demo/web (mounted at /srv) to the machine's shared Caddy,
# which adds HTTPS for game.sindansolutions.com. Set up by
# deploy/setup_downloads.sh; deploy/publish_client.sh fills the folder
# and puts a changed copy of this file in place (deploy/web_files.sh).
#
# /play/ is the browser game. Its WebSockets go to /net/, which is passed
# to the web gateway container, game-demo-gateway, on the same Docker
# network (deploy/install.sh starts it with each server release).
:80 {
	root * /srv

	# Launchers ask for this every 10 seconds; it must never be cached.
	@live path /manifest.txt /GameDemo.exe /index.html /
	header @live Cache-Control "no-cache"

	# Named by their hash, so a file here never changes.
	@files path /files/*
	header @files Cache-Control "public, max-age=31536000, immutable"

	# The browser game keeps its names from one version to the next, so
	# browsers ask each time whether it changed.
	@play path /play/*
	header @play Cache-Control "no-cache"

	@launcher path /GameDemo.exe
	header @launcher Content-Disposition "attachment; filename=GameDemo.exe"

	handle /net/* {
		reverse_proxy game-demo-gateway:27080
	}

	handle {
		file_server
	}
}
