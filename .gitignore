# Compiler output from build.bat (written into build/)
*.obj
*.pdb
*.map
*.exp
*.lib
!lib/**/*.lib
build/*.exe
build/*.dll
build/server
# Runtime copy the exe makes so app.dll can be hot-reloaded
app_temp.dll
# build.bat copies these from web/fonts
build/fonts/
# misc\screenshot.bat output
build/*.png
# art.bat previews
build/monster_art/
build/probe
build/bots
# misc\land.bat logs
build/land_*.log
# test.bat output of the programs it runs at once
build/*_tests*.log
build/*_tests*.code
build/gcc_*.log
build/gcc_*.code
build/gcc_works.*
build/layout.log
build/layout.code
build/*.tmp
# webuild.bat copies these from build/shaders/fx
web/shaders/fx/
build/client_src/
build/client_package/
# build.bat compiles code/platform/game.rc into this
build/*.res
